+set(VST2_SDK_PATH "${PROJECT_SOURCE_DIR}/include/vstsdk" CACHE STRING "VST2 SDK Path")
+
+set(VSTSDK_ROOT
+    "${VST2_SDK_PATH}"
+    "${VST2_SDK_PATH}/pluginterfaces/vst2.x/"
+    "${VST2_SDK_PATH}/public.sdk/source/vst2.x/"
+)
+
+set(VSTSDK_SOURCES
