+
+function(add_airwindows_plugin name)
+    file(GLOB plug_src
+            src/${name}/*.h
+            src/${name}/*.cpp)
+    message(${plug_src})
+    add_library(${name} MODULE ${VSTSDK_SOURCES} ${plug_src})
+    target_include_directories(${name} PRIVATE ${VSTSDK_ROOT} ${PROJECT_SOURCE_DIR}/${name})
+    set_target_properties(${name} PROPERTIES PREFIX "")
+endfunction(add_airwindows_plugin)
+
 
